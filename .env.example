NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
# Generate a unique key with npm run setup; never place it in browser code.
OPERATOR_API_KEY=
PENDING_HOURS=48
AUTH_RATE_LIMIT=10
PUBLIC_RATE_LIMIT=20
# Configure a trusted notification delivery bridge for email delivery:
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_KEY=
# Only enable behind exactly one trusted reverse proxy:
TRUST_PROXY=0
# Optional absolute SQLite path; default is ./data/bouncebash.sqlite
# DB_PATH=

# Optional production PostgreSQL/Supabase connection (server-side only):
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_SSL=true
# DATABASE_CA_CERT=
# Use HTTPS PUBLIC_URL and NODE_ENV=production in hosted production.
